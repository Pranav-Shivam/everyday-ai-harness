# Copy this file to .env and fill in the values. .env is ignored by Git.

# --- Model (Python version only; the Claude Code version does not use these) ---
# Any OpenAI-compatible chat completions endpoint. This example is a local one.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=YOUR_MODEL_NAME

# --- Local data. These paths are ignored by Git. ---------------------------
# SQLite file, created automatically. No database server needed.
# Relative to where you start the app (repo root for the Python version).
HARNESS_DATABASE=data/harness.sqlite3
HARNESS_LOG_FILE=logs/runs.jsonl
HARNESS_ASSISTANT_FILE=config/assistant.md
HARNESS_PROFILE_FILE=config/profile.md

# --- Runtime limits (Python version). Keep these bounded. -----------------
HARNESS_MAX_STEPS=6
HARNESS_MAX_TOOL_CALLS=8
HARNESS_HISTORY_TURNS=5
HARNESS_REQUEST_TIMEOUT=60
